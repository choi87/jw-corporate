---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../config/company';
interface Props { title: string; description?: string; }
const { title, description = company.description } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://jw-corporate.pages.dev';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09162b" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={company.legalName} />
    <meta property="og:title" content={`${title} | ${company.legalName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} | {company.legalName}</title>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-white focus:p-3">본문 바로가기</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
