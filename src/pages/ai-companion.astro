---
import '../styles/global.css';
const art = '/images/ai-companion';
const title = 'AI Companion · AI 캐릭터 육성 비서';
const description = '스마트폰에서 대화하고 함께 성장하는 AI 캐릭터 육성 비서의 개발 계획. 로컬 AI와 기본 육성부터 인형집, 맞춤 추천과 영어 학습 확장까지 소개합니다.';
const canonical = 'https://jwcorp.net/ai-companion/';
const phases = [
  { when: '2026년 12월 목표', title: '로컬 AI와 기본 육성', copy: 'Android 기기에서 작동하는 AI 비서와 기본 육성은 무료로 제공할 계획입니다. 특별 복장과 스킨 등 꾸미기 상품에만 부분 유료화를 적용할 예정입니다.' },
  { when: '2027년 1~4월 목표', title: '공동생활과 학습', copy: '인형집과 아르바이트를 추가하고, 외부 AI를 이용한 맞춤 추천과 영어 학습 DLC를 개발할 계획입니다. 온라인 AI에는 무료 이용 한도와 선택형 구독을 검토합니다.' },
  { when: '2027년 5월 이후 검토', title: '졸업 이후의 별도 확장', copy: '직업과 사회생활을 경험하는 독립 확장 서비스를 검토할 예정입니다. 일반판은 계속 독립적으로 이용할 수 있도록 기획합니다.' },
];
const chapters = [
  ['assistant','AI 비서'], ['growth','캐릭터 성장'], ['life','공동생활'], ['roadmap','개발 로드맵'],
];
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#101426" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(art + '/evening.webp', canonical).href} />
  <title>{title}</title>
</head>
<body>
  <a class="sr-only focus:not-sr-only focus:fixed focus:z-50 focus:bg-white focus:p-3" href="#main">본문 바로가기</a>
  <div class="companion">
    <header class="brand-bar">
      <div class="container-jw">
        <a class="wordmark" href="#main"><span aria-hidden="true">✦</span> AI Companion</a>
        <nav aria-label="AI Companion 메뉴">{chapters.map(([id,label]) => <a href={'#' + id}>{label}</a>)}</nav>
        <a class="brand-return" href="/projects/ai-companion/">JW 프로젝트 <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main">
    <section class="hero" aria-labelledby="intro">
      <img class="hero-art" src={art + '/evening.webp'} width="1720" height="860" fetchpriority="high" alt="저녁 창가에서 작은 빛의 영혼을 손 위에 띄운 은빛 머리 AI 캐릭터 콘셉트" />
      <div class="container-jw hero-content">
        <p class="status"><span></span> 개발 예정</p>
        <p class="project-name">AI 캐릭터 육성 비서 <small>(가칭)</small></p>
        <h1 id="intro">당신을 이해하고,<br/>함께 성장하는 AI.</h1>
        <p class="lead">내일의 약속을 챙기고, 오늘 나눈 이야기를 기억하는 친구. 스마트폰 속 작은 영혼이 나만의 AI 비서로 자라는 과정을 기획하고 있습니다.</p>
        <div class="actions"><a class="primary" href="#assistant">프로젝트 알아보기 <span aria-hidden="true">↓</span></a><a class="secondary" href="#roadmap">개발 로드맵</a></div>
      </div>
      <small class="art-note">대표 캐릭터 콘셉트 아트</small>
    </section>
    <section id="assistant" class="container-jw chapter">
      <p class="kicker">1단계 계획 · 개인 AI 비서</p>
      <h2>하루의 작은 약속부터.</h2>
      <p class="intro-text">말로 일정을 남기고, 미뤄 둔 할 일을 떠올리고, 한 주의 생활을 돌아보는 비서를 구상합니다. 아래는 같은 날의 대화가 일정과 생활 기록으로 이어지는 화면 시안입니다.</p>
      <div class="screens" aria-label="AI 비서 화면 시안">
        <article class="screen"><small>화면 시안 · 대화</small><h3>오늘의 대화</h3><p class="bubble mine">저녁 7시에 산책할 거야.</p><p class="bubble theirs">좋아요. 저녁 산책을 일정에 적어 둘게요.</p></article>
        <article class="screen"><small>화면 시안 · 일정</small><h3>나의 일정</h3><div class="appointment"><b>19:00</b><div><strong>저녁 산책</strong><p>공원 한 바퀴 걷기</p></div></div><p class="detail">대화에서 정한 약속과 할 일을 한곳에 모으는 구상입니다.</p></article>
        <article class="screen"><small>화면 시안 · 생활 기록</small><h3>이번 주 산책</h3><div class="week" aria-label="예시 기록. 월요일, 수요일, 금요일 산책">{['월','화','수','목','금','토','일'].map((day,i) => <div><i class:list={[[0,2,4].includes(i) && 'walked']}></i>{day}</div>)}</div><p class="detail">함께 기록한 활동을 돌아보며 대화 주제와 다음 일정을 제안할 계획입니다.</p></article>
      </div>
      <aside class="local"><div><p class="kicker">온디바이스 AI</p><h3>기억은 내 스마트폰에.</h3></div><div><p>기본 대화는 Gemma 4 기반 로컬 AI로 기기 안에서 처리하고, 인터넷 연결이 없어도 사용할 수 있도록 개발할 예정입니다.</p><p>대화와 취향은 로컬 저장을 우선합니다. 사용자가 기억을 수정·삭제하고 암호화 백업을 선택할 수 있게 하며, 향후 외부 AI로 정보를 보낼 때는 별도 동의를 받을 계획입니다.</p></div></aside>
      <figure class="on-device"><figcaption>기기 내부 처리 구상</figcaption><ol><li>음성·텍스트 입력</li><li>스마트폰의 로컬 AI</li><li>대화 응답·기억 저장</li></ol></figure>
    </section>
    <section id="growth" class="growth"><div class="container-jw chapter">
      <p class="kicker">1단계 계획 · 캐릭터 육성</p><h2>같은 시작, 서로 다른 성장.</h2>
      <p class="intro-text">작은 영혼에게 이름을 지어 주는 날부터 이야기가 시작됩니다. 대화와 공동 활동을 쌓으며 초등학교부터 졸업까지 약 30~90일에 걸쳐 함께 자라는 과정을 구상합니다.</p>
      <figure class="progression"><img loading="lazy" src={art + '/growth.webp'} width="1300" height="650" alt="작은 영혼에서 초등학생, 중학생, 고등학생을 거쳐 졸업하는 캐릭터의 모습" /><figcaption><ol>{['영혼의 탄생','초등학교','중학교','고등학교','졸업'].map(label => <li>{label}</li>)}</ol>성장 단계 콘셉트</figcaption></figure>
      <div class="personality"><div><h3>함께한 시간이 만든 개성</h3><p>같은 산책에서도 누군가는 길가의 꽃을 기억하고, 누군가는 새 길을 궁금해합니다. 캐릭터 고유의 기질에 함께한 경험이 더해져 표정과 말투, 취향이 달라지도록 설계할 예정입니다.</p></div>
      <figure><img loading="lazy" src={art + '/personalities.webp'} width="1200" height="480" alt="다정함, 차분함, 활발함, 탐구심을 표정과 차림으로 표현한 캐릭터 네 가지" /><figcaption>성격에 따른 모습의 예시</figcaption></figure></div>
    </div></section>
    <section id="life" class="life"><div class="container-jw chapter">
      <p class="kicker">2단계 계획 · 인형집과 라이프스타일</p><h2>졸업 후, 함께 사는 작은 집.</h2>
      <div class="house"><figure><img loading="lazy" src={art + '/dollhouse.webp'} width="1200" height="800" alt="취향이 다른 세 개의 개인 방과 주방, 공동 거실이 있는 인형집 단면" /><figcaption>개인 방과 공동 공간을 표현한 인형집 콘셉트</figcaption></figure>
      <div class="features"><article><h3>인형집과 아르바이트</h3><p>최대 세 캐릭터가 개인 방을 꾸미고 거실에서 만나는 생활을 구상합니다. 아르바이트로 모은 게임 화폐로 취미를 즐기거나 가구를 고르는 방식입니다.</p></article><article><h3>취향을 기억하는 추천</h3><p>외부 AI와 인터넷 검색으로 음식, 의류, 생활용품을 찾아보는 기능을 계획합니다. 예를 들어 산책 후 들를 식당을 캐릭터와 함께 고르는 경험입니다.</p></article><article><h3>함께 공부하는 영어 DLC</h3><p>잠금을 풀 때 단어 하나를 만나고, 저녁에는 같은 단어로 짧은 대화를 나누는 선택형 영어 학습 확장팩을 기획합니다.</p></article></div></div>
      <div class="examples" aria-label="2단계 확장 기능 화면 시안">
        <article><small>맞춤 추천 · 화면 시안</small><h3>산책 후에 뭘 먹을까?</h3><p class="bubble theirs">지난번에 따뜻한 국물을 좋아한다고 했지? 오늘은 근처 국숫집을 찾아볼까?</p><p class="caption">취향을 반영한 추천 대화 예시</p></article>
        <article><small>영어 DLC · 화면 시안</small><h3 lang="en">stroll <span>산책하다</span></h3><blockquote lang="en">“Shall we take a stroll?”</blockquote><p class="caption">“우리 산책할까?” 오늘의 단어를 대화에 써 보는 예시</p></article>
      </div>
    </div></section>
    <section id="roadmap" class="container-jw chapter">
      <p class="kicker">개발 로드맵</p><h2>무엇을, 언제 준비할까요?</h2><p class="intro-text">현재 프로젝트는 개발 예정 단계입니다. 아래 일정은 개발 목표이며 실제 출시 시점과 제공 범위는 개발 및 심사 상황에 따라 달라질 수 있습니다.</p>
      <ol class="phases">{phases.map((phase,i) => <li><div><b>{i+1}단계</b><small>{phase.when}</small></div><h3>{phase.title}</h3><p>{phase.copy}</p></li>)}</ol>
      <div class="closing"><div><p class="kicker">Android · Google Play 출시 예정</p><h3>첫 만남을 준비하고 있습니다.</h3></div><a class="secondary" href="/">JW 공식 홈페이지 <span aria-hidden="true">↗</span></a></div>
    </section>
    </main>
    <footer class="brand-footer"><div class="container-jw">
      <p class="wordmark"><span aria-hidden="true">✦</span> AI Companion</p>
      <a class="brand-return" href="/projects/ai-companion/">JW 프로젝트 설명으로 돌아가기 <span aria-hidden="true">↗</span></a>
    </div></footer>
  </div>
</body>
</html>
<style>
  .companion { background:#101426; color:#f5f5ff; word-break:keep-all; overflow-wrap:break-word; }
  .hero { position:relative; isolation:isolate; background:#151a30; }
  .hero-art { position:absolute; inset:0; z-index:-2; width:100%; height:100%; object-fit:cover; object-position:50% 43%; }
  .hero::before { content:''; position:absolute; inset:0; background:linear-gradient(90deg,#101426ed 0%,#101426b3 36%,transparent 64%); z-index:-1; }
  .hero-content { padding-block:clamp(28px,4vw,60px) clamp(55px,7vw,110px); }
  .art-note,figcaption,.screen small,.phases small,.kicker,.status { font-size:.875rem; }
  .secondary { color:#eef0ff; }
  .status { margin:clamp(24px,4vw,64px) 0 12px; display:flex; align-items:center; gap:.6rem; font-weight:700; color:#d8ceff; }
  .status span { width:8px; height:8px; border-radius:50%; background:#baacff; }
  .project-name { font-weight:650; color:#e4e3ff; }
  .project-name small { font-weight:400; }
  h1,h2,h3 { text-wrap:balance; letter-spacing:-.05em; }
  h1 { margin:12px 0 19px; font-size:clamp(2.65rem,4.8vw,5rem); line-height:1.12; font-weight:800; }
  .lead,.intro-text,.local p,.features p,.personality p,.phases p { line-height:1.85; }
  .lead { max-width: min(43%,440px); color:#e1e2ef; font-size:1.05rem; }
  .actions { margin-top:30px; display:flex; flex-wrap:wrap; gap:10px; }
  .primary,.secondary { display:inline-flex; min-height:46px; align-items:center; justify-content:center; gap:16px; border-radius:9px; font-weight:700; padding:10px 18px; font-size:.95rem; }
  .primary { background:#d7caff; color:#201936; }
  .secondary { border:1px solid #a7a7bc; background:#161a30ad; }
  .primary:hover { background:white; } .secondary:hover { background:#383750; }
  .art-note { position:absolute; bottom:12px; right:20px; background:#15192bc9; color:white; border-radius:4px; padding:3px 8px; }
  .brand-bar { position:sticky; top:0; z-index:10; border-bottom:1px solid #36394f; background:#15182cef; backdrop-filter:blur(12px); }
  .brand-bar .container-jw,.brand-footer .container-jw { display:flex; justify-content:space-between; align-items:center; gap:16px; }
  .wordmark { display:inline-flex; align-items:center; gap:.55rem; white-space:nowrap; font-weight:760; letter-spacing:-.035em; font-size:1.2rem; }
  .wordmark span { color:#c7b8ff; font-size:1.55rem; }
  .brand-bar nav { display:flex; gap:clamp(14px,3vw,44px); }
  .brand-bar a { display:inline-flex; align-items:center; min-height:64px; }
  .brand-bar nav a,.brand-return { color:#dedaf4; font-size:.875rem; font-weight:650; }
  .brand-return span { margin-left:5px; color:#baaafa; }
  .brand-bar a:hover,.brand-footer a:hover { text-decoration:underline; text-underline-offset:5px; }
  .brand-footer { border-top:1px solid #36394f; padding-block:22px; }
  .chapter { padding-block:clamp(54px,7vw,96px); }
  section[id] { scroll-margin-top:76px; }
  .kicker { color:#bcb0ff; font-weight:700; margin-bottom:10px; }
  h2 { font-size:clamp(2rem,3.75vw,3.6rem); line-height:1.2; font-weight:780; }
  h3 { font-size:clamp(1.28rem,2vw,1.75rem); line-height:1.35; font-weight:730; }
  .intro-text { margin-top:18px; max-width:42rem; color:#ccd0e2; }
  .screens { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(12px,2.2vw,30px); margin-top:32px; }
  .screen { background:linear-gradient(140deg,#292d48,#1c213b); border:1px solid #444663; border-radius:24px; padding:clamp(20px,2.4vw,32px); }
  .screen small { color:#c6bded; } .screen h3 { margin:6px 0 24px; }
  .bubble { width:fit-content; max-width:92%; padding:10px 14px; border-radius:15px 15px 15px 3px; font-size:.975rem; line-height:1.55; }
  .mine { margin-left:auto; background:#c8b9fb; color:#211c37; border-radius:15px 15px 3px 15px; }
  .theirs { background:#414765; margin-top:10px; }
  .appointment { border-left:3px solid #ad9df5; padding-left:14px; display:flex; gap:12px; } .appointment b { color:#cfc2ff; }
  .appointment p,.detail { color:#cdd1e4; font-size:.95rem; line-height:1.7; } .detail { margin-top:20px; }
  .week { display:flex; justify-content:space-between; text-align:center; color:#d1cee2; font-size:.875rem; }
  .week i { display:block; width:16px; height:16px; border:1px solid #aaa8bd; border-radius:50%; margin:0 auto 5px; } .week .walked { background:#beadfa; }
  .local,.personality { display:grid; grid-template-columns:.85fr 1.4fr; gap:clamp(25px,5vw,70px); align-items:start; margin-top:48px; border-top:1px solid #393e55; padding-top:32px; }
  .local p:not(.kicker),.features p,.phases p { color:#cdd1e2; } .local p + p,.features p,.personality p { margin-top:10px; }
  .on-device { border:1px solid #484c68; border-radius:16px; padding:18px 24px; margin-top:24px; }
  .on-device figcaption { margin:0 0 12px; color:#d0c3ff; }
  .on-device ol { display:flex; flex-wrap:wrap; gap:12px 20px; align-items:center; font-weight:600; }
  .on-device li:not(:last-child)::after { content:'→'; margin-left:20px; color:#afa1dc; }
  .growth { color:#201d35; background:#f2eff7; } .growth .kicker { color:#605186; } .growth .intro-text,.personality p { color:#534e67; }
  .progression,.house { margin-top:30px; } figure img { width:100%; border-radius:16px; }
  figcaption { margin-top:10px; color:#b7bdcf; } .growth figcaption { color:#625a72; }
  .progression ol { display:grid; grid-template-columns:repeat(5,1fr); margin:0 0 12px; padding:10px 0; border-bottom:1px solid #c9c3d3; color:#353044; font-weight:bold; text-align:center; }
  .personality { align-items:center; border-color:#d4ccdf; }
  .life { background:#191d32; } .house { display:grid; grid-template-columns:1.35fr 1fr; gap:clamp(28px,4vw,60px); align-items:center; }
  .features article + article { border-top:1px solid #3b4057; margin-top:20px; padding-top:20px; }
  .examples { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; margin-top:36px; }
  .examples article { background:#24283e; border-radius:18px; padding:clamp(20px,3vw,32px); }
  .examples small,.examples h3 span { font-size:.9rem; color:#c9beea; }
  .examples h3 { margin:8px 0 16px; } .examples h3 span { font-weight:500; letter-spacing:0; }
  .examples blockquote { font-size:1.35rem; color:#e2d9ff; } .caption { margin-top:16px; font-size:.875rem; color:#c1c6da; }
  .phases { margin-top:32px; } .phases li { border-top:1px solid #41455c; padding:24px 0; display:grid; grid-template-columns: .65fr 1fr 1.65fr; gap:24px; align-items:baseline; }
  .phases li b,.phases li small { display:block; } .phases li b { color:#c6b7ff; } .phases li small { color:#c0c3d1; margin-top:6px; }
  .closing { border-radius:16px; background:linear-gradient(100deg,#21243a 25%,#272943cc),url('/images/ai-companion/evening.webp') center 35% / cover; padding:clamp(22px,4vw,46px); margin-top:36px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
