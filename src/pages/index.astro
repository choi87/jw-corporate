---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { company } from '../config/company';
import { publicProjects } from '../data/projects';
import { pageLocale } from '../data/locales';
const { code, t, href } = pageLocale(Astro.url.pathname);
const areas = [
  { no: '01', en: 'Software & Applications', ko: t("소프트웨어 및 애플리케이션"), text: t("웹·모바일 애플리케이션과 소프트웨어를 기획·개발합니다.") },
  { no: '02', en: 'AI & Automation', ko: t("AI 및 업무 자동화"), text: t("AI 기반 서비스와 자동화 시스템, 데이터 활용 솔루션을 다룹니다.") },
  { no: '03', en: 'E-Commerce', ko: t("전자상거래"), text: t("전자상거래 서비스와 디지털 유통 시스템을 추진합니다.") },
  { no: '04', en: 'Digital Platforms', ko: t("디지털 플랫폼"), text: t("온라인 플랫폼과 사용자 참여형 디지털 서비스를 설계합니다.") },
];
---
<BaseLayout title={t("HOME")}>
  <section class="relative overflow-hidden bg-navy-950 py-24 text-white md:py-36">
    <video autoplay muted loop playsinline preload="metadata" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full object-cover object-[65%_center] motion-reduce:hidden">
      <source src="/videos/jw-office-clean.mp4" type="video/mp4" />
    </video>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-linear-to-r from-navy-950/95 via-navy-950/75 to-navy-950/20"></div>
    <div class="container-jw relative">
      <p class="mb-7 text-xs font-bold tracking-[.25em] text-sky-300">{t("JW CORPORATE WEBSITE")}</p>
      <h1 style={code === "th" ? "container-type:inline-size" : undefined} class="max-w-4xl text-4xl font-extrabold leading-[1.22] tracking-[-.055em] md:text-6xl">{t("Technology for")}<br /><span class="text-sky-300" style={code === "th" ? "display:inline-block;white-space:nowrap;font-size:min(1em,8.8cqi);-webkit-text-size-adjust:100%;text-size-adjust:100%" : undefined} data-fit-thai-slogan={code === "th" ? "" : undefined}>{t("practical progress.")}</span></h1>
      <p class="mt-7 max-w-xl text-base leading-8 text-slate-300 break-keep">{t(company.legalName)}{t("는 디지털 기술을 바탕으로 실용적인 서비스의 가능성을 탐색하고 제품 개발을 추진합니다.")}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={href("/business/")} class="rounded-lg bg-white px-6 py-3 text-sm font-bold text-navy-950 transition hover:bg-slate-100">{t("사업영역 살펴보기")} <span aria-hidden="true">→</span></a>
        <a href={href("/company/")} class="rounded-lg border border-white/30 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10">{t("회사 소개")}</a>
      </div>
    </div>
  </section>
  <section class="container-jw grid gap-8 py-18 md:grid-cols-[1fr_auto] md:items-center md:py-24"><div><p class="eyebrow mb-4">{t("ABOUT JW")}</p><h2 class="section-title text-navy-950">{t(company.legalName)}</h2><p class="mt-4 max-w-2xl break-keep text-sm leading-8 text-muted">{t("소프트웨어와 디지털 기술을 기반으로 다양한 사업 기회를 검토하고 서비스를 개발합니다. 확인된 회사 정보와 프로젝트 현황을 투명하게 안내합니다.")}</p></div><a href={href("/company/")} class="inline-flex w-fit items-center rounded-lg border border-line px-6 py-3 text-sm font-bold text-navy-950 transition hover:bg-surface">{t("회사 소개 보기 →")}</a></section>
  <section class="container-jw py-18 md:py-24">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-5"><div><p class="eyebrow mb-4">{t("BUSINESS AREAS")}</p><h2 class="section-title text-navy-950">{t("관심을 사업으로, 아이디어를 제품으로")}</h2></div><a href={href("/business/")} class="inline-flex w-fit items-center rounded-lg border border-line px-6 py-3 text-sm font-bold text-navy-950 transition hover:bg-surface">{t("사업영역 전체 보기 →")}</a></div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{areas.map((area) => <article class="card-panel p-6"><p class="eyebrow mb-7">{area.no}</p><h3 class="text-lg font-bold text-navy-950">{t(area.en)}</h3><p class="mt-1 text-sm font-semibold text-ink">{area.ko}</p><p class="mt-4 text-sm leading-7 text-muted">{area.text}</p></article>)}</div>
  </section>
  <section class="bg-surface py-18 md:py-24">
    <div class="container-jw"><div class="mb-10 flex flex-wrap items-end justify-between gap-5"><div><p class="eyebrow mb-4">PROJECTS</p><h2 class="section-title text-navy-950">{t("진행 중인 프로젝트")}</h2></div><a href={href("/projects/")} class="inline-flex w-fit items-center rounded-lg border border-line px-6 py-3 text-sm font-bold text-navy-950 transition hover:bg-surface">{t("프로젝트 더 보기 →")}</a></div><div class="grid gap-5 md:grid-cols-2">{publicProjects.slice(0, 2).map((project) => <ProjectCard project={project} />)}</div></div>
  </section>
  <section class="bg-navy-950 py-14 text-white"><div class="container-jw flex flex-wrap items-center justify-between gap-6"><div><p class="text-xs font-bold tracking-[.18em] text-sky-300">{t("CONTACT")}</p><h2 class="mt-3 text-2xl font-bold">{t("사업 및 제휴 문의")}</h2></div><a href={href("/contact/")} class="rounded-lg bg-white px-6 py-3 text-sm font-bold text-navy-950">{t("문의 안내 보기 →")}</a></div></section>
</BaseLayout>

{code === "th" && (
  <script is:inline>
    (() => {
      const line = document.querySelector('[data-fit-thai-slogan]');
      const heading = line?.closest('h1');
      if (!heading) return;

      function fit() {
        const width = heading.clientWidth;
        const maximum = parseFloat(getComputedStyle(heading).fontSize);
        if (!width || !maximum) return;
        line.style.fontSize = maximum + 'px';
        if (line.getBoundingClientRect().width <= width) return;

        let low = 0;
        let high = maximum;
        while (high - low > 0.1) {
          const size = (low + high) / 2;
          line.style.fontSize = size + 'px';
          if (line.getBoundingClientRect().width <= width - 1) low = size;
          else high = size;
        }
        line.style.fontSize = low + 'px';
      }

      fit();
      if (typeof ResizeObserver !== 'undefined') new ResizeObserver(fit).observe(heading);
      else window.addEventListener('resize', fit);
      document.fonts?.ready.then(fit);
    })();
  </script>
)}
