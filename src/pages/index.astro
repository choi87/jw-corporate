---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../config/company';
const areas = [
  { no: '01', en: 'Software & Applications', ko: '소프트웨어 및 애플리케이션', text: '사용자 경험과 실제 활용성을 중심으로 디지털 제품을 기획·개발합니다.' },
  { no: '02', en: 'AI & Automation', ko: 'AI 및 업무 자동화', text: 'AI 기술과 자동화 흐름을 활용해 업무 효율 개선 가능성을 연구합니다.' },
  { no: '03', en: 'E-Commerce', ko: '전자상거래', text: '온라인 거래 환경과 디지털 유통 운영을 위한 기술을 검토합니다.' },
  { no: '04', en: 'Digital Platforms', ko: '디지털 플랫폼', text: '서비스와 사용자를 연결하는 확장 가능한 플랫폼 구조를 설계합니다.' },
];
---
<BaseLayout title="HOME">
  <section class="relative overflow-hidden bg-navy-950 py-27 text-white md:py-37">
    <div aria-hidden="true" class="pointer-events-none absolute -right-40 top-0 h-130 w-130 rounded-full border border-white/10"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 top-24 h-105 w-105 rounded-full border border-white/10"></div>
    <div aria-hidden="true" class="pointer-events-none absolute right-24 top-48 h-72 w-72 rounded-full border border-white/10"></div>
    <div class="container-jw relative">
      <p class="mb-7 text-xs font-bold tracking-[.25em] text-sky-300">JW CORPORATE WEBSITE</p>
      <h1 class="max-w-4xl text-4xl font-extrabold leading-[1.22] tracking-[-.055em] md:text-6xl">Technology for<br /><span class="text-sky-300">practical progress.</span></h1>
      <p class="mt-7 max-w-xl text-base leading-8 text-slate-300">{company.legalName}는 소프트웨어와 디지털 기술을 기반으로 실용적인 서비스의 가능성을 탐색하고 개발합니다.</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/business/" class="rounded-lg bg-white px-6 py-3 text-sm font-bold text-navy-950 transition hover:bg-slate-100">사업영역 살펴보기 <span aria-hidden="true">→</span></a>
        <a href="/company/" class="rounded-lg border border-white/30 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10">회사 소개</a>
      </div>
    </div>
  </section>
  <section class="container-jw py-19 md:py-25">
    <div class="mb-11 flex flex-wrap items-end justify-between gap-5">
      <div><p class="eyebrow mb-3">OUR BUSINESS</p><h2 class="section-title text-navy-950">네 가지 기술 사업 영역</h2></div>
      <a href="/business/" class="text-sm font-bold text-blue-700 hover:underline">자세히 보기 <span aria-hidden="true">→</span></a>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {areas.map(area => <article class="card-panel p-7 md:p-9"><div class="mb-8 text-xs font-bold tracking-widest text-blue-600">{area.no} / BUSINESS</div><h3 class="text-xl font-bold tracking-tight text-navy-950">{area.en}</h3><p class="mt-2 font-semibold text-ink">{area.ko}</p><p class="mt-5 text-sm leading-7 text-muted">{area.text}</p></article>)}
    </div>
  </section>
  <section class="bg-surface py-19 md:py-24">
    <div class="container-jw flex flex-col gap-7 md:flex-row md:items-center md:justify-between">
      <div><p class="eyebrow mb-3">PROJECTS</p><h2 class="section-title text-navy-950">새로운 디지털 경험을 위한 개발</h2><p class="mt-4 max-w-xl text-sm leading-7 text-muted">현재 기획·개발 단계의 프로젝트를 소개합니다. 출시 여부와 개발 상태는 프로젝트별로 구분해 표기합니다.</p></div>
      <a href="/projects/" class="w-fit rounded-lg bg-navy-950 px-6 py-3 text-sm font-bold text-white hover:bg-navy-800">프로젝트 보기 <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
