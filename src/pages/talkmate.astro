---
import '../styles/global.css';

const downloadUrl = 'https://github.com/choi87/jw-corporate/releases/tag/talkmate-v2.0.55';
const chatExamples = [
  [
    "상담은 몇 시까지 가능한가요?",
    "안녕하세요! 평일 오후 6시까지 상담하실 수 있어요."
  ],
  [
    "주말에도 문의할 수 있나요?",
    "메시지는 언제든 남겨주세요. 담당자 확인이 필요하면 다음 영업일에 안내해 드려요."
  ],
  [
    "방문 상담은 예약해야 하나요?",
    "네. 원하시는 날짜와 시간을 알려주시면 가능한 일정을 확인해 드릴게요."
  ],
  [
    "내일 오후 2시는 어떤가요?",
    "내일 오후 2시로 요청을 남겨드릴게요. 확정되면 안내 메시지를 보내드려요."
  ],
  [
    "예약을 변경하려면 어떻게 하나요?",
    "기존 예약 시간과 변경을 원하시는 시간을 함께 알려주세요."
  ],
  [
    "방문 전에 안내를 받을 수 있나요?",
    "네. 예약이 확정되면 방문 전날 안내를 보내드릴 수 있어요."
  ],
  [
    "방문할 때 준비할 게 있나요?",
    "상담하고 싶은 내용을 간단히 적어 오시면 안내가 더 쉬워요."
  ],
  [
    "담당자와 직접 이야기할 수 있을까요?",
    "문의 내용을 남겨주시면 담당자가 확인할 수 있도록 전달해 드릴게요."
  ],
  [
    "전화 상담도 가능한가요?",
    "네. 통화 가능한 시간대를 알려주시면 담당자에게 전달해 드려요."
  ],
  [
    "알겠습니다. 감사합니다!",
    "문의해 주셔서 감사합니다. 궁금한 점이 생기면 언제든 메시지를 남겨주세요."
  ]
];
const features = [
  { icon: 'reply', title: 'AI 자동응답', description: '반복해서 들어오는 문의에 AI가 자동으로 답하도록 설정하세요.' },
  { icon: 'clock', title: '메시지 예약전송', description: '안내 문구와 보낼 시간을 미리 정해 두고 필요한 때에 전달하세요.' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="톡메이트는 반복 문의에 자동으로 응답하고 안내 메시지를 예약할 수 있는 프로그램입니다." />
    <meta name="theme-color" content="#180c30" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://jwcorp.net/talkmate/" />
    <title>톡메이트 다운로드 | Talkmate</title>
  </head>
  <body class="talkmate antialiased">
    <header class="border-b border-white/10">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-5">
        <a href="/talkmate/" class="flex items-center gap-3 text-xl font-black tracking-tight">
          <span class="grid size-10 place-items-center rounded-xl bg-violet-500 text-white" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-7l-5 4v-4H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><path d="M7 9h10M7 13h6"/></svg>
          </span>
          Talkmate
        </a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-17 md:py-25 lg:grid-cols-[1fr_1fr]">
          <div>
            <h1 class="text-5xl font-black tracking-tight sm:text-7xl">톡메이트</h1>
            <p class="mt-5 text-2xl font-bold leading-snug text-violet-200 sm:text-3xl">반복 문의는 자동으로,<br />안내 메시지는 제시간에.</p>
            <p class="mt-5 max-w-md text-base leading-8 text-violet-100">AI 자동응답과 메시지 예약전송을 한곳에서 관리하는 프로그램입니다.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#download" class="inline-flex items-center gap-3 rounded-xl bg-violet-300 px-6 py-3.5 font-extrabold text-[#26124e] transition hover:bg-white">다운로드 <span aria-hidden="true">↓</span></a>
              <a href="#guide" class="inline-flex items-center rounded-xl border border-violet-300/45 px-6 py-3.5 font-bold text-white hover:bg-white/10">사용 방법</a>
            </div>
          </div>

          <figure class="preview m-0 min-w-0 rounded-3xl border border-violet-300/25 bg-[#251441] shadow-2xl">
            <figcaption class="flex items-center justify-between gap-3 border-b border-white/10 px-5 py-4">
              <span class="font-bold">Talkmate</span><button id="talkmate-chat-toggle" type="button" hidden class="sr-only focus:not-sr-only rounded-md border border-violet-300/35 px-2 py-1 text-xs text-violet-200">일시정지</button>
            </figcaption>
            <div id="talkmate-chat" data-examples={JSON.stringify(chatExamples)} class="space-y-4 p-4 sm:p-6">
              <div id="talkmate-chat-history" tabindex="0" aria-label="고객 문의와 AI 답변 예시" class="h-64 space-y-3 overflow-y-auto overscroll-contain pr-1">
                <div class="rounded-2xl bg-white/7 p-4">
                  <p class="text-sm font-semibold text-violet-200">고객 문의</p>
                  <p class="mt-2">{chatExamples[0][0]}</p>
                </div>
                <div class="ml-5 rounded-2xl bg-violet-500/25 p-4">
                  <p class="text-sm font-semibold text-violet-200">AI 자동응답</p>
                  <p class="mt-2">{chatExamples[0][1]}</p>
                </div>
              </div>
              <div class="flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-violet-300/20 px-4 py-3">
                <span class="text-sm text-violet-100">안내 메시지</span>
                <span class="rounded-full bg-violet-300 px-3 py-1 text-xs font-bold text-[#26124e]">내일 오전 10시 발송 예약</span>
              </div>
            </div>
          </figure>
        </div>
      </section>

      <section class="bg-[#f8f5ff] px-6 py-16 text-[#26124e]" aria-label="주요 기능">
        <div class="mx-auto grid max-w-6xl gap-5 md:grid-cols-2">
          {features.map(({icon,title,description}) => (
            <article class="rounded-2xl border border-violet-200 bg-white p-7">
              <span class="grid size-11 place-items-center rounded-xl bg-violet-100 text-violet-800" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
                  {icon === 'clock' ? <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></> : <path d="M9 9V5l-6 6 6 6v-4h4a5 5 0 0 1 5 5v1h3v-2a8 8 0 0 0-8-8Z"/>}
                </svg>
              </span>
              <h2 class="mt-4 text-xl font-extrabold">{title}</h2>
              <p class="mt-3 leading-7 text-[#54456e]">{description}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="guide" class="scroll-mt-6 bg-white px-6 py-18 text-[#26124e]">
        <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[1fr_1.6fr]">
          <div>
            <h2 class="text-3xl font-black tracking-tight sm:text-4xl">톡메이트 사용 방법</h2>
            <p class="mt-4 max-w-sm leading-7 text-[#54456e]">자주 오는 질문의 답변을 준비하고, 공지나 안내 메시지는 보내고 싶은 시간에 맞춰 예약하세요.</p>
          </div>
          <ol class="space-y-4">
            <li class="rounded-2xl border border-violet-200 bg-[#f8f5ff] p-6"><h3 class="text-lg font-extrabold">1. 설치하고 실행하기</h3><p class="mt-2 leading-7 text-[#54456e]">아래에서 설치 파일을 내려받아 설치한 뒤 톡메이트를 실행합니다.</p></li>
            <li class="rounded-2xl border border-violet-200 bg-[#f8f5ff] p-6"><h3 class="text-lg font-extrabold">2. 자동응답 설정하기</h3><p class="mt-2 leading-7 text-[#54456e]">자주 묻는 질문과 답변에 필요한 정보를 정리해 자동응답을 설정합니다. 테스트 메시지로 답변을 확인한 뒤 사용하세요.</p></li>
            <li class="rounded-2xl border border-violet-200 bg-[#f8f5ff] p-6"><h3 class="text-lg font-extrabold">3. 발송 시간 예약하기</h3><p class="mt-2 leading-7 text-[#54456e]">보낼 메시지를 작성하고 발송 날짜와 시간을 지정합니다. 메시지 내용과 예약 시간을 확인한 뒤 저장하세요.</p></li>
          </ol>
        </div>
      </section>

      <section id="download" class="scroll-mt-6 bg-[#251441] px-6 py-17 text-center">
        <h2 class="text-3xl font-black sm:text-4xl">톡메이트 다운로드</h2>
        {downloadUrl ? (
          <a href={downloadUrl} class="mt-6 inline-flex rounded-xl bg-violet-300 px-7 py-3.5 font-extrabold text-[#26124e] hover:bg-white">v2.0.55 다운로드</a>
        ) : (
          <button type="button" disabled class="mt-6 rounded-xl bg-violet-300/25 px-7 py-3.5 font-extrabold text-violet-100">다운로드 준비 중</button>
        )}
      </section>
    </main>

  </body>
</html>

<style>
  #talkmate-chat-history {
    scrollbar-width: none;
  }

  #talkmate-chat-history::-webkit-scrollbar {
    display: none;
  }


  body.talkmate {
    background: #180c30;
    color: #fff;
  }

  .hero {
    background: radial-gradient(ellipse at 74% 20%, #512a86, transparent 62%), #180c30;
  }

  .preview {
    overflow-wrap: anywhere;
    box-shadow: 0 24px 75px rgb(11 3 30 / .45);
  }
</style>

<script>
  const chat = document.querySelector<HTMLElement>('#talkmate-chat');
  const history = document.getElementById('talkmate-chat-history');
  const toggle = document.querySelector<HTMLButtonElement>('#talkmate-chat-toggle');

  if (chat?.dataset.examples && history && toggle) {
    const examples: [string, string][] = JSON.parse(chat.dataset.examples);
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let step = 0;
    let waitingForAnswer = false;
    let playing = !motion.matches;
    let timer: number | undefined;

    const appendMessage = (message: string, isAnswer: boolean) => {
      const bubble = document.createElement('div');
      bubble.className = isAnswer ? 'ml-5 rounded-2xl bg-violet-500/25 p-4' : 'rounded-2xl bg-white/7 p-4';
      const label = document.createElement('p');
      label.className = 'text-sm font-semibold text-violet-200';
      label.textContent = isAnswer ? 'AI 자동응답' : '고객 문의';
      const body = document.createElement('p');
      body.className = 'mt-2';
      body.textContent = message;
      bubble.append(label, body);
      history.append(bubble);
      if (history.childElementCount > 24) history.firstElementChild?.remove();
      history.scrollTo({ top: history.scrollHeight, behavior: motion.matches ? 'auto' : 'smooth' });
      if (!motion.matches) bubble.animate(
        [{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }],
        { duration: 280, easing: 'ease-out' },
      );
    };

    const schedule = () => {
      window.clearTimeout(timer);
      toggle.textContent = playing ? '일시정지' : '재생';
      if (!playing || document.hidden) return;
      timer = window.setTimeout(() => {
        if (waitingForAnswer) {
          appendMessage(examples[step][1], true);
        } else {
          step = (step + 1) % examples.length;
          appendMessage(examples[step][0], false);
        }
        waitingForAnswer = !waitingForAnswer;
        schedule();
      }, waitingForAnswer ? 1100 : 3600);
    };

    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      playing = !playing;
      schedule();
    });
    motion.addEventListener('change', () => {
      playing = !motion.matches;
      schedule();
    });
    document.addEventListener('visibilitychange', schedule);
    schedule();
  }
</script>
