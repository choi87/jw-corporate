---
import Home from '../index.astro';
import Company from '../company.astro';
import Sustainability from '../sustainability.astro';
import Investors from '../investors.astro';
import Careers from '../careers.astro';
import Projects from '../projects.astro';
import ProjectDetail from '../projects/[id].astro';
import Business from '../business.astro';
import Contact from '../contact.astro';
import Privacy from '../privacy.astro';
import { languages, sections } from '../../data/locales';
import { publicProjects, type Project } from '../../data/projects';

export function getStaticPaths() {
  const pages: { section: typeof sections[number] | undefined; project?: Project }[] =
    [undefined, ...sections].map((section) => ({ section }));
  return languages.filter(({ code }) => code !== 'ko').flatMap(({ code }) => [
    ...pages.map((page) => ({ params: { locale: code, section: page.section }, props: page })),
    ...publicProjects.map((project) => ({
      params: { locale: code, section: 'projects/' + project.id },
      props: { section: 'projects' as const, project },
    })),
  ]);
}

const pages = { company: Company, sustainability: Sustainability, investors: Investors, careers: Careers, projects: Projects, business: Business, contact: Contact, privacy: Privacy };
const { section, project } = Astro.props;
const Page = section ? pages[section] : Home;
---
{project ? <ProjectDetail project={project} /> : <Page />}
