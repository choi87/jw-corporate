  .brand { color: #f5f0dc; font-weight: 850; }
  .back:hover, footer a:hover { text-decoration: underline; }
  .hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(28px, 6vw, 88px); padding-block: clamp(40px, 8vw, 110px); }
  h1 { margin: 0 0 18px; color: #e4c875; font-size: clamp(2rem, 5vw, 4rem); line-height: 1.12; letter-spacing: -.06em; }
  .lead { margin: 0; font-size: clamp(1.45rem, 3.4vw, 2.5rem); font-weight: 850; line-height: 1.24; letter-spacing: -.055em; }
  em { color: #b9d3a4; font-style: normal; }
  .intro { max-width: 34em; margin: 22px 0; color: #cbd0bf; }
  .cta { display: inline-flex; gap: 1rem; align-items: center; color: #192014; background: #e4c875; border-radius: 7px; padding: 11px 19px; font-weight: 850; }
  .cta:hover { background: #f8de93; }
  .example { min-width: 0; margin: 0; padding: 16px; background: #1e2920; border: 1px solid #58694f; border-radius: 24px; box-shadow: 0 20px 48px #0005; }
  figcaption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px 12px; padding: 0 4px 12px; font-weight: 800; }
  figcaption span { color: #cbd0bf; font-weight: 500; font-size: .82rem; }
  .felt { padding: 15px 12px; border: 2px solid #849c74; border-radius: 30% / 25%; background: radial-gradient(ellipse, #386b42, #21472d 75%); display: grid; justify-items: center; gap: 12px; }
  .seat, .pot { text-align: center; font-size: .78rem; }
  .seat strong, .pot strong { display: block; }
  .seat { background: #152b1d; border-radius: 10px; padding: 5px 12px; }
  .hero-seat { border: 1px solid #b8cb9d; }
  .pot strong { color: #f9dc8c; font-size: 1.05rem; }
  .hand { display: flex; gap: 7px; }
  .hand span { display: grid; place-items: center; width: 43px; height: 61px; background: #fcf6e4; border-radius: 6px; color: #16201b; font: bold 22px/1 Georgia, serif; padding: 6px; }
  .hand small { font-size: 17px; }
  .hand .red { color: #a52c39; }
  .choices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 14px; text-align: center; font-size: .85rem; font-weight: 750; }
  .choices span { border: 1px solid #64745f; padding: 5px 3px; border-radius: 7px; }
  .practice { background: #f3efdd; color: #19261c; padding-block: clamp(36px, 6vw, 76px); }
  h2 { margin: 0 0 24px; font-size: clamp(1.6rem, 4vw, 2.5rem); letter-spacing: -.055em; }
  ol { padding: 0; margin: 0; list-style: none; counter-reset: step; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  li { counter-increment: step; padding: 20px; border: 1px solid #b8bdab; border-radius: 13px; background: #fbf8ed; }
  li::before { content: '0' counter(step); font: 850 1rem system-ui, sans-serif; color: #46684b; }
  h3 { margin: 6px 0; font-size: 1.15rem; }
  li p, .note { margin: 0; color: #465447; }
  .note { margin-top: 20px; font-size: .9rem; }
  @media (max-width: 750px) {
    .hero, ol { grid-template-columns: 1fr; }
    .example { max-width: 540px; }
  }
</style>
