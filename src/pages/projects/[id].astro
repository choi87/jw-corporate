---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { publicProjects, statusLabel, type Project } from '../../data/projects';
import { pageLocale } from '../../data/locales';
const { t, href } = pageLocale(Astro.url.pathname);

export function getStaticPaths() {
  return publicProjects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const details: Record<string, string[]> = {
  "poker-ev-trainer": [
    t("상황별 선택지"),
    t("테이블 인원, 포지션, 스택과 팟 크기, 상대의 이전 행동을 보고 다음 행동을 고릅니다."),
    t("기대값 비교"),
    t("폴드·콜·레이즈 등 선택지의 기대값(EV)을 비교하고 풀이를 확인합니다.")
  ],
  "trading-automation": [
    t("시장 조건 분석"),
    t("주식과 가상자산의 시세를 분석해 사용자가 정한 진입 조건을 확인합니다."),
    t("전략과 주문 관리"),
    t("진입·청산 조건, 손절·익절 기준, 주문 설정을 전략별로 관리합니다.")
  ],
  "resale-price-search": [
    t("해외 상품 시세 검색"),
    t("해외 리셀 중개사이트에 올라온 상품 가격을 한곳에서 비교합니다."),
    t("구매 비용 비교"),
    t("표시 가격에 환율과 배송비를 반영해 실제 구매 비용을 비교합니다.")
  ],
  "youtube-automation": [
    t("영상 편집"),
    t("긴 원본 영상에서 주요 장면을 추려 하이라이트를 구성하고 자막과 번역을 준비합니다."),
    t("게시 준비"),
    t("썸네일과 제목·키워드를 준비하고 지정한 시간에 게시하도록 예약합니다.")
  ],
  "card-pack-inventory": [
    t("카드팩 탐색"),
    t("상품별 카드팩 정보를 살펴보고 구매 가능한 상품을 확인합니다."),
    t("판매와 재고"),
    t("상품 판매 화면과 상품별 재고 검색·관리 기능을 함께 제공합니다.")
  ],
  "sword-enhancement-game": [
    t("제작과 강화"),
    t("리듬 미니게임으로 검을 만들고, 강화와 합성으로 성장시키는 구조를 기획하고 있습니다."),
    t("대전과 수집"),
    t("여러 자루의 검을 선택해 지형과 상대의 선택을 고려하는 대전과 도감 수집을 구상하고 있습니다.")
  ],
  "brand-investment-distribution": [
    t("브랜드 발굴"),
    t("상품과 고객층을 살펴보고 투자나 협업 가능성을 검토합니다."),
    t("판매 채널"),
    t("브랜드의 상품 특성과 고객층에 맞는 판매 채널을 검토합니다.")
  ],
  "video-production-distribution": [
    t("영상 기획·제작"),
    t("주제와 대상 시청자를 정하고, 그에 맞춰 영상을 기획하고 제작하는 프로젝트입니다."),
    t("채널별 유통"),
    t("채널에 맞는 영상 길이와 형식을 검토하고 배포 흐름을 설계합니다.")
  ],
  "ai-reply-scheduler": [
    t("AI 자동응답"),
    t("반복해서 들어오는 문의에 AI가 자동으로 답하도록 설정합니다."),
    t("예약전송"),
    t("안내 메시지를 준비하고 날짜와 시간을 지정해 발송을 예약합니다.")
  ]
};

interface Props { project: Project }
const { project } = Astro.props;
const [firstTitle, firstBody, secondTitle, secondBody] = details[project.id] ?? [];
---
<BaseLayout title={t(project.name)} description={t(project.description)}>
  {project.id === 'card-pack-inventory' ? (
    <>
      <section class="isolate overflow-hidden bg-linear-to-r from-navy-950 via-navy-950 to-blue-950 text-white">
        <div class="container-jw relative py-14 md:py-24">
          <div>
            <a href={href("/projects/#commerce")} class="text-sm font-semibold text-sky-200 underline-offset-4 hover:underline">{t("← 프로젝트 목록")}</a>
            <p class="mt-9 text-sm font-semibold text-sky-200">{t("트레이딩 카드팩 플랫폼")}</p>
            <h1 class="mt-3 text-5xl font-black tracking-tight md:text-7xl">ORIPA<span class="text-sky-300">.ASIA</span></h1>
            <p class="mt-5 max-w-lg break-keep leading-8 text-slate-200">{t("찾고 있는 카드에 맞춰 카드팩을 살펴보고, 지역별 재고를 실시간으로 확인해 구매할 수 있는 서비스입니다.")}</p>
            <a href="https://oripa.asia/" class="mt-8 inline-flex items-center gap-3 rounded-lg bg-sky-300 px-6 py-3.5 text-sm font-extrabold text-navy-950 transition hover:bg-white">{t("ORIPA.ASIA 방문하기")} <span aria-hidden="true">↗</span></a>
          </div>
          <div aria-hidden="true" class="pointer-events-none absolute top-1/2 left-[62%] -z-10 flex h-56 w-80 -translate-x-1/2 -translate-y-1/2 items-center justify-center opacity-30 md:left-[55%] md:h-64 md:opacity-45">
            <div class="absolute h-52 w-36 -translate-x-15 -rotate-14 rounded-2xl border border-sky-300/35 bg-blue-800/60 shadow-xl"></div>
            <div class="absolute h-52 w-36 translate-x-15 rotate-14 rounded-2xl border border-sky-300/35 bg-blue-800/60 shadow-xl"></div>
            <div class="relative flex h-56 w-40 flex-col items-center justify-center rounded-2xl border border-sky-300/60 bg-linear-to-br from-blue-800 to-navy-950 shadow-2xl">
              <div class="mb-5 h-10 w-10 rotate-45 rounded-lg border-2 border-sky-300"></div>
              <span class="text-2xl font-black tracking-tight opacity-55">ORIPA</span>
              <span class="mt-2 text-xs tracking-widest text-sky-200 opacity-55">{t("TRADING CARDS")}</span>
            </div>
          </div>
        </div>
      </section>
      <section class="container-jw py-14 md:py-20" aria-labelledby="oripa-features">
        <h2 id="oripa-features" class="section-title text-navy-950">{t("서비스 주요 기능")}</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-2">
          <article class="card-panel p-7 md:p-8">
            <h3 class="text-xl font-bold text-navy-950">{t("원하는 카드에 맞춘 카드팩")}</h3>
            <p class="mt-3 break-keep leading-8 text-muted">{t("고객이 찾는 카드와 수집 목적에 맞춰 카드팩을 구성합니다. 카드팩에 어떤 카드가 포함될 수 있는지 살펴보고 원하는 카드에 도전할 수 있습니다.")}</p>
          </article>
          <article class="card-panel p-7 md:p-8">
            <h3 class="text-xl font-bold text-navy-950">{t("지역별 카드 재고 실시간 확인")}</h3>
            <p class="mt-3 break-keep leading-8 text-muted">{t("지역별로 카드 재고를 실시간으로 확인할 수 있습니다. 원하는 카드가 어디에 있는지 한눈에 파악해 여러 판매처에 일일이 문의하는 수고를 덜 수 있습니다.")}</p>
          </article>
        </div>
      </section>
      <section class="border-t border-line bg-surface py-14 md:py-20" aria-labelledby="oripa-outlook">
        <div class="container-jw max-w-5xl">
          <h2 id="oripa-outlook" class="section-title text-navy-950">{t("카드팩의 미래 전망")}</h2>
          <p class="mt-5 break-keep leading-8 text-muted">{t("수집가는 원하는 카드가 포함된 팩을 찾고, 어디에서 구매할 수 있는지 빠르게 확인하고 싶어 합니다. ORIPA.ASIA는 고객이 찾는 카드를 바탕으로 카드팩 구성을 다양화하고, 지역별 판매처와 연계해 재고를 확인할 수 있는 범위를 넓히는 방향을 검토하고 있습니다.")}</p>
          <p class="mt-4 break-keep leading-8 text-muted">{t("앞으로는 카드팩 구성, 판매가, 재고 갱신 시점 같은 정보를 한눈에 비교할 수 있도록 개선해 고객이 구매를 결정하기 쉽게 만드는 것이 목표입니다.")}</p>
        </div>
      </section>
    </>
  ) : (
    <>
  <PageHero
    eyebrow={t(project.businessArea)}
    title={t(project.name)}
    subtitle={t(project.description)}
    illustration={project.id === 'ai-reply-scheduler' ? '/images/ai-reply-messenger.webp' : undefined}
  />
  <section class="container-jw py-14 md:py-20">
    <a href={href("/projects/")} class="text-sm font-bold text-blue-700 underline-offset-4 hover:underline">{t("← 프로젝트 목록")}</a>
    {project.status && (
      <dl class="mt-8">
        <dt class="text-sm font-semibold text-muted">{t("진행 상태")}</dt>
        <dd class="mt-2 text-lg font-bold text-navy-950">{t(statusLabel[project.status])}</dd>
      </dl>
    )}
    {firstTitle && (
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <article class="card-panel p-7"><h2 class="text-xl font-bold text-navy-950">{firstTitle}</h2><p class="mt-3 break-keep leading-8 text-muted">{firstBody}</p></article>
        <article class="card-panel p-7"><h2 class="text-xl font-bold text-navy-950">{secondTitle}</h2><p class="mt-3 break-keep leading-8 text-muted">{secondBody}</p></article>
      </div>
    )}
    {project.id === 'ai-reply-scheduler' && (
      <a href="/talkmate/" class="mt-8 inline-flex items-center gap-3 rounded-lg bg-violet-700 px-6 py-3.5 font-bold text-white transition hover:bg-violet-800">
        {t("톡메이트 다운로드")} <span aria-hidden="true">↗</span>
      </a>
    )}
    {project.externalLink && project.status === 'released' && (
      <a href={project.externalLink} class="mt-8 inline-block font-bold text-blue-700 hover:underline">{t("프로그램 사이트 방문 ↗")}</a>
    )}
  </section>
    </>
  )}
</BaseLayout>
