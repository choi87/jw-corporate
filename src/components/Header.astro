---
import { company } from '../config/company';
const nav = [
  { href: '/company/', label: '기업정보' },
  { href: '/sustainability/', label: '지속가능경영' },
  { href: '/investors/', label: '투자정보' },
  { href: '/careers/', label: '인재채용' },
  { href: '/projects/', label: '프로젝트' },
];
const path = Astro.url.pathname;
const languages = [
  { code: 'ko', label: '한국어' },
  { code: 'en', label: 'English' },
  { code: 'zh-CN', label: '中文（简体）' },
  { code: 'zh-TW', label: '中文（繁體）' },
  { code: 'th', label: 'ไทย' },
  { code: 'ja', label: '日本語' },
];
---
<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur-md">
  <div class="container-jw flex min-h-18 items-center justify-between gap-2 sm:gap-6">
    <a href="/" class="flex min-w-0 items-center gap-2 text-navy-950 sm:gap-3" aria-label="제이더블유 홈">
      <img src="/favicon.svg" width="40" height="40" alt="" class="block h-8 w-8 shrink-0 sm:h-10 sm:w-10" />
      <span id="site-company-name" class="truncate text-[0.8rem] font-extrabold tracking-tight sm:text-[0.94rem]">{company.legalName}</span>
    </a>
    <div class="flex shrink-0 items-center gap-1 sm:gap-3 md:gap-4">
    <nav aria-label="주 메뉴" class="hidden items-center gap-4 lg:flex xl:gap-7">
      {nav.map((item) => <a href={item.href} aria-current={path === item.href ? 'page' : undefined} class:list={['whitespace-nowrap text-sm font-bold transition hover:text-blue-700', path === item.href ? 'text-blue-700' : 'text-muted']}>{item.label}</a>)}
    </nav>
        <details id="site-languages" class="notranslate group relative" translate="no">
      <summary aria-label="언어 선택 / Choose language" class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full text-navy-950 transition hover:bg-surface focus-visible:outline-2 focus-visible:outline-blue-700 marker:hidden [&::-webkit-details-marker]:hidden">
        <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.55" aria-hidden="true">
          <circle cx="12" cy="12" r="9.25"/><ellipse cx="12" cy="12" rx="4.1" ry="9.25"/><path d="M3 9h18M3 15h18"/>
        </svg>
      </summary>
      <div class="absolute right-0 top-full z-50 mt-2 w-40 rounded-xl border border-line bg-white p-1.5 shadow-xl before:absolute before:-top-1.5 before:right-4 before:h-3 before:w-3 before:rotate-45 before:border-l before:border-t before:border-line before:bg-white">
        {languages.map(({ code, label }) => (
          <button type="button" data-site-language={code} lang={code} aria-current={code === 'ko' ? 'true' : undefined} class="relative block w-full rounded-lg px-3 py-2 text-left text-sm font-semibold text-navy-950 hover:bg-surface focus-visible:outline-2 focus-visible:outline-blue-700 aria-[current=true]:bg-blue-50 aria-[current=true]:text-blue-700">{label}</button>
        ))}
        <p id="site-translation-status" class="relative px-3 py-2 text-xs text-muted" role="status" hidden></p>
      </div>
    </details>
    <details class="group relative lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-1 whitespace-nowrap rounded-md border border-line px-2 py-2 text-xs font-semibold marker:hidden sm:px-3 sm:text-sm [&::-webkit-details-marker]:hidden"><span>메뉴</span><span aria-hidden="true" translate="no">☰</span></summary>
      <nav aria-label="모바일 주 메뉴" class="absolute right-0 top-12 w-48 rounded-xl border border-line bg-white p-3 shadow-xl">
        {nav.map((item) => <a href={item.href} aria-current={path === item.href ? 'page' : undefined} class="block rounded-md px-3 py-2.5 text-sm font-semibold hover:bg-surface">{item.label}</a>)}
      </nav>
    </details>
    </div>
  </div>
</header>
<div id="site-translation-provider" hidden aria-hidden="true" inert></div>

<script is:inline>
  (() => {
    const menu = document.getElementById('site-languages');
    const provider = document.getElementById('site-translation-provider');
    const status = document.getElementById('site-translation-status');
    const buttons = [...menu.querySelectorAll('[data-site-language]')];
    const supported = new Set(buttons.map((button) => button.dataset.siteLanguage));
    const key = 'jw-site-language';
    const url = new URL(location.href);
    const requested = url.searchParams.get('lang');
    let saved;
    try { saved = localStorage.getItem(key); } catch {}
    const language = supported.has(requested) ? requested : supported.has(saved) ? saved : 'ko';

    // Remove preferences used by the previous widget, including parent-domain cookies.
    for (const domain of ['', '; Domain=' + location.hostname, '; Domain=jwcorp.net']) {
      document.cookie = 'googtrans=; Max-Age=0; Path=/; SameSite=Lax' + domain;
    }

    const selectLanguage = (code) => {
      try { localStorage.setItem(key, code); } catch {}
      if (code === 'ko') url.searchParams.delete('lang');
      else url.searchParams.set('lang', code);
      if (url.href === location.href) location.reload();
      else location.assign(url.href);
    };

    menu.addEventListener('click', (event) => {
      const option = event.target.closest('[data-site-language]');
      if (option) selectLanguage(option.dataset.siteLanguage);
    });
    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target)) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary').focus();
      }
    });

    function markLanguage(code) {
      for (const button of buttons) {
        if (button.dataset.siteLanguage === code) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
      }
    }

    if (language === 'en') {
      const companyName = document.getElementById('site-company-name');
      companyName.textContent = 'JW Co.,Ltd.';
      companyName.setAttribute('translate', 'no');
      companyName.classList.add('notranslate');
    }

    if (language === 'ko') return;
    document.documentElement.dataset.siteLanguage = language;
    document.documentElement.classList.add('jw-translated');
    status.hidden = false;
    status.textContent = '번역 중… / Translating…';

    function showFailure() {
      status.hidden = false;
      status.textContent = '번역을 불러오지 못했습니다. 다시 선택해 주세요. / Translation unavailable. Please try again.';
      menu.open = true;
    }

    const timeout = setTimeout(showFailure, 12000);
    const translated = new MutationObserver(() => {
      const root = document.documentElement;
      if (!root.matches('.translated-ltr, .translated-rtl')) return;
      clearTimeout(timeout);
      status.hidden = true;
      markLanguage(language);
      root.lang = language;
      translated.disconnect();
    });
    translated.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    window.jwInitializeTranslation = () => {
      try {
        const applyLanguage = () => {
          const select = provider.querySelector('select.goog-te-combo');
          if (!select || ![...select.options].some((option) => option.value === language)) return false;
          select.value = language;
          select.dispatchEvent(new Event('change', { bubbles: true }));
          return true;
        };
        const controls = new MutationObserver(() => {
          if (applyLanguage()) controls.disconnect();
        });
        controls.observe(provider, { childList: true, subtree: true });
        setTimeout(() => controls.disconnect(), 12000);
        new window.google.translate.TranslateElement({
          pageLanguage: 'ko',
          includedLanguages: 'en,zh-CN,zh-TW,th,ja',
          autoDisplay: false
        }, provider.id);
        if (applyLanguage()) controls.disconnect();
      } catch {
        clearTimeout(timeout);
        showFailure();
      }
    };
    const script = document.createElement('script');
    script.src = 'https://translate.google.com/translate_a/element.js?cb=jwInitializeTranslation';
    script.async = true;
    script.addEventListener('error', () => {
      clearTimeout(timeout);
      showFailure();
    });
    document.head.append(script);
  })();
</script>

<style is:global>
  @media (max-width: 639px) {
    html[data-site-language="ja"] #site-company-name {
      font-size: clamp(0.625rem, 3vw, 0.8125rem);
    }

    html.jw-translated main {
      overflow-x: clip;
      overflow-wrap: anywhere;
    }

    html.jw-translated main .break-keep {
      word-break: normal;
    }
  }

  #site-translation-provider[hidden],
  html.jw-translated iframe.goog-te-banner-frame,
  html.jw-translated iframe.skiptranslate,
  html.jw-translated body > .skiptranslate:has(iframe) {
    display: none !important;
  }

  html.jw-translated body {
    top: 0 !important;
  }
</style>
