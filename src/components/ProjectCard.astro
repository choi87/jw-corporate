---
import type { Project } from '../data/projects';
import { statusLabel } from '../data/projects';
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="card-panel flex flex-col overflow-hidden">
  {project.image && <img src={project.image} alt="" class="aspect-[5/3] w-full bg-navy-950 object-cover" loading="lazy" />}
  <div class="flex flex-1 flex-col p-7 md:p-8">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <span class="text-xs font-bold tracking-wide text-muted">{project.businessArea}</span>
      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">{statusLabel[project.status]}</span>
    </div>
    <h2 class="text-xl font-bold tracking-tight text-navy-950">{project.name}</h2>
    <p class="mt-4 flex-1 text-sm leading-8 text-muted">{project.description}</p>
    {project.externalLink && project.status === 'released' && <a href={project.externalLink} target="_blank" rel="noopener noreferrer" class="mt-7 text-sm font-semibold text-blue-700 underline-offset-4 hover:underline">프로젝트 사이트 방문 <span aria-hidden="true">↗</span></a>}
  </div>
</article>
