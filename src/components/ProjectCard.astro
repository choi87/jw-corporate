---
import type { Project } from '../data/projects';
import { statusLabel } from '../data/projects';
import { pageLocale } from '../data/locales';
const { t, href } = pageLocale(Astro.url.pathname);
interface Props { project: Project; headingLevel?: 'h2' | 'h3'; }
const { project, headingLevel: Heading = 'h2' } = Astro.props;
---
<article class="card-panel relative flex flex-col overflow-hidden transition hover:border-blue-600 focus-within:border-blue-600">
  {project.image && <img src={project.image} alt="" class="aspect-[5/3] w-full bg-navy-950 object-cover" loading="lazy" />}
  <div class="flex flex-1 flex-col p-7 md:p-8">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <span class="text-xs font-bold tracking-wide text-muted">{t(project.businessArea)}</span>
      {project.status && <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">{t(statusLabel[project.status])}</span>}
    </div>
    <Heading class="text-xl font-bold tracking-tight text-navy-950"><a href={href(`/projects/${project.id}/`)} class="after:absolute after:inset-0 hover:text-blue-700"><span data-fit-brand-title={project.id === 'brand-investment-distribution' ? '' : undefined} class:list={[project.id === 'brand-investment-distribution' && 'inline-block whitespace-nowrap']}>{t(project.name)}<span aria-hidden="true" class="ml-2 text-blue-700">→</span></span></a></Heading>
    <p class="mt-4 flex-1 break-keep text-sm leading-8 text-muted">{t(project.description)}</p>
    {project.externalLink && project.status === 'released' && <a href={project.externalLink} target="_blank" rel="noopener noreferrer" class="relative z-10 mt-7 text-sm font-semibold text-blue-700 underline-offset-4 hover:underline">{t("프로젝트 사이트 방문")} <span aria-hidden="true">↗</span></a>}
  </div>
</article>

<script>
  for (const title of document.querySelectorAll<HTMLElement>('[data-fit-brand-title]')) {
    const heading = title.closest('h2, h3');
    if (!heading) continue;

    const fit = () => {
      title.style.fontSize = '';
      const naturalWidth = title.getBoundingClientRect().width;
      const availableWidth = heading.clientWidth;
      if (availableWidth > 0 && naturalWidth > availableWidth) {
        const size = parseFloat(getComputedStyle(title).fontSize);
        title.style.fontSize = `${size * (availableWidth - 1) / naturalWidth}px`;
      }
    };

    fit();
    new ResizeObserver(fit).observe(heading);
    void document.fonts.ready.then(fit);
  }
</script>
