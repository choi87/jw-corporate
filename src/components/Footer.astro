---
import { company, contact } from '../config/company';
---
<footer class="border-t border-line bg-white py-7">
  <div class="container-jw flex flex-wrap justify-between gap-x-12 gap-y-4">
    <div>
      <nav aria-label="하단 메뉴" class="flex flex-wrap items-center gap-3 text-sm">
        <a href="/privacy/" class="font-bold text-blue-700 hover:underline">개인정보처리방침</a>
        <a href="/contact/" class="border-l border-line pl-3 text-navy-950 hover:underline">찾아오시는 길</a>
      </nav>
      <address class="mt-3 text-sm not-italic text-muted">{company.address}</address>
      <p class="mt-1 text-sm text-muted">이메일 <a href="mailto:contact@jwcorp.net" class="font-semibold text-blue-700 hover:underline">contact@jwcorp.net</a></p>
      <p class="mt-1 text-xs text-muted">© {new Date().getFullYear()} {company.legalName}. All rights reserved.</p>
    </div>
    {contact.hasPhone && <a href={`tel:${company.phone}`} class="text-sm font-semibold text-navy-950 hover:underline">대표전화 <span class="text-blue-700">{company.phone}</span></a>}
  </div>
</footer>
