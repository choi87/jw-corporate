---
import { company, contact } from '../config/company';
---
<footer class="border-t border-line bg-surface py-12">
  <div class="container-jw grid gap-8 md:grid-cols-[1fr_auto] md:items-start">
    <div>
      <div class="mb-3 text-lg font-black text-navy-950">JW <span class="ml-2 text-sm font-bold">{company.legalName}</span></div>
      <p class="max-w-lg text-sm leading-7 text-muted">{company.description}</p>
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-muted">
        {company.ceo && <span>대표자: {company.ceo}</span>}
        {company.registrationNumber && <span>사업자등록번호: {company.registrationNumber}</span>}
        {company.address && <span>주소: {company.address}</span>}
        {company.established && <span>설립일: {company.established}</span>}
        {contact.hasPhone && <a href={`tel:${company.phone.replace(/[^\d+]/g,'')}`} class="underline-offset-4 hover:underline">전화: {company.phone}</a>}
        {contact.hasEmail && <a href={`mailto:${company.email}`} class="underline-offset-4 hover:underline">이메일: {company.email}</a>}
      </div>
    </div>
    <div class="flex flex-wrap gap-5 text-xs font-semibold text-muted">
      <a href="/company/" class="hover:text-navy-950">회사 소개</a>
      <a href="/contact/" class="hover:text-navy-950">문의</a>
      <a href="/privacy/" class="hover:text-navy-950">개인정보처리방침</a>
    </div>
  </div>
  <div class="container-jw mt-10 border-t border-line pt-6 text-xs text-muted">© {new Date().getFullYear()} {company.legalName}. All rights reserved.</div>
</footer>
