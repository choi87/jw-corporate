---
import { company, contact } from '../config/company';
import { pageLocale } from '../data/locales';
const { t, href } = pageLocale(Astro.url.pathname);
---
<footer class="border-t border-line bg-white py-7">
  <div class="container-jw flex flex-wrap justify-between gap-x-12 gap-y-4">
    <div>
      <nav aria-label={t("하단 메뉴")} class="flex flex-wrap items-center gap-3 text-sm">
        <a href={href("/privacy/")} class="font-bold text-blue-700 hover:underline">{t("개인정보처리방침")}</a>
        <a href={href("/contact/")} class="border-l border-line pl-3 text-navy-950 hover:underline">{t("찾아오시는 길")}</a>
      </nav>
      <address class="mt-3 text-sm not-italic text-muted">{t(company.address)}</address>
      <p class="mt-1 text-xs text-muted">© {new Date().getFullYear()} {t(company.legalName).replace(/\.$/, "")}. {t("All rights reserved.")}</p>
    </div>
    <div class="flex flex-col items-start gap-1.5">
      {contact.hasPhone && <a href={`tel:${company.phone}`} class="text-sm font-semibold text-navy-950 hover:underline">{t("대표전화")} <span class="text-blue-700">{company.phone}</span></a>}
        <p class="mt-1 text-sm font-semibold text-navy-950">{t("이메일")} <a href="mailto:contact@jwcorp.net" class="font-semibold text-blue-700 hover:underline">contact@jwcorp.net</a></p>
    </div>
  </div>
</footer>
