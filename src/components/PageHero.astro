---
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  illustration?: string;
  theme?: 'holdem' | 'companion';
  backLink?: { href: string; label: string };
}
const { eyebrow, title, subtitle, illustration, backLink, theme } = Astro.props;
---
<section class:list={[
  "border-b border-line md:py-24",
  theme === 'companion' ? "py-10" : backLink ? "py-14" : "py-17",
  theme === 'holdem'
    ? "relative isolate overflow-hidden bg-linear-to-r from-[#f5fbf5] to-[#e0f0e4]"
    : illustration || theme === 'companion'
    ? "relative isolate overflow-hidden bg-linear-to-r from-[#fbf8fe] to-[#efe5f9]"
    : "bg-surface",
]}>
  <div class:list={["container-jw", (illustration || theme) && "relative", theme === "holdem" && "lg:grid lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-center lg:gap-10 lg:pr-8"]}>
    {illustration && (
      <img
        src={illustration}
        alt=""
        width="960"
        height="640"
        class="pointer-events-none absolute top-1/2 -right-14 -z-10 h-56 w-auto max-w-none -translate-y-1/2 opacity-25 md:right-auto md:left-[min(53%,36rem)] md:h-64 md:opacity-40"
        fetchpriority="high"
      />
    )}
    <div class:list={[theme && "relative z-10"]}>
    {backLink && (
      <a href={backLink.href} class:list={["text-sm font-semibold underline-offset-4 hover:underline", theme === "holdem" ? "text-emerald-800" : "text-violet-800"]}>{backLink.label}</a>
    )}
    <p class:list={backLink ? ["mt-9 text-sm font-semibold", theme === "holdem" ? "text-emerald-800" : "text-violet-800"] : "eyebrow mb-5"}>{eyebrow}</p>
    <h1 class:list={[
      "max-w-4xl text-4xl leading-tight tracking-[-.05em] text-navy-950 md:text-5xl",
      backLink ? "mt-3 font-black" : "font-extrabold",
      (illustration || theme === 'companion') && "break-keep wrap-anywhere",
    ]}>{title}</h1>
    <p class:list={[
      "text-base leading-8",
      theme === 'companion' ? "text-ink" : "text-muted",
      backLink ? "mt-5 max-w-lg" : "mt-6 max-w-2xl",
      (illustration || theme === 'companion') && "break-keep",
    ]}>{subtitle}</p>
    <slot name="actions" />
    </div>
    {theme === "holdem" && (
      <div class="pointer-events-none absolute top-1/2 -right-12 w-64 -translate-y-1/2 opacity-25 blur-[0.6px] md:right-auto md:left-[clamp(12rem,23vw,21rem)] md:w-[27rem] md:opacity-40 lg:static lg:w-full lg:max-w-[27rem] lg:translate-y-0 lg:justify-self-center">
        <slot name="artwork" />
      </div>
    )}
    {theme === "companion" && (
      <div class="companion-art pointer-events-none absolute top-1/2 -z-10 -translate-y-1/2" aria-hidden="true">
        <slot name="artwork" />
      </div>
    )}
  </div>
</section>
<style>
  .companion-art {
    left: clamp(5rem, 9vw, 9rem);
    width: min(67vw, 42rem);
    opacity: .58;
    background: radial-gradient(ellipse at 58% 50%, #d8c6f9aa, transparent 68%);
    mask-image: linear-gradient(to right, transparent, #000 47%), linear-gradient(to bottom, #000 72%, transparent);
    mask-composite: intersect;
  }
  @media (max-width: 767px) {
    .companion-art {
      left: auto;
      right: -3rem;
      width: clamp(21rem, 90vw, 35rem);
      opacity: .30;
    }
  }
</style>
