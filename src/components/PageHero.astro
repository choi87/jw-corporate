---
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  illustration?: string;
  backLink?: { href: string; label: string };
}
const { eyebrow, title, subtitle, illustration, backLink } = Astro.props;
---
<section class:list={[
  "border-b border-line md:py-24",
  backLink ? "py-14" : "py-17",
  illustration
    ? "relative isolate overflow-hidden bg-linear-to-r from-[#fbf8fe] to-[#efe5f9]"
    : "bg-surface",
]}>
  {illustration && (
    <img
      src={illustration}
      alt=""
      width="960"
      height="640"
      class="pointer-events-none absolute top-1/2 -right-14 -z-10 h-56 w-auto max-w-none -translate-y-1/2 opacity-25 md:right-[5%] md:h-64 md:opacity-40"
      fetchpriority="high"
    />
  )}
  <div class="container-jw">
    {backLink && (
      <a href={backLink.href} class="text-sm font-semibold text-violet-800 underline-offset-4 hover:underline">{backLink.label}</a>
    )}
    <p class={backLink ? "mt-9 text-sm font-semibold text-violet-800" : "eyebrow mb-5"}>{eyebrow}</p>
    <h1 class:list={[
      "max-w-4xl text-4xl leading-tight tracking-[-.05em] text-navy-950 md:text-5xl",
      backLink ? "mt-3 font-black" : "font-extrabold",
      illustration && "break-keep wrap-anywhere",
    ]}>{title}</h1>
    <p class:list={[
      "text-base leading-8 text-muted",
      backLink ? "mt-5 max-w-lg" : "mt-6 max-w-2xl",
      illustration && "break-keep",
    ]}>{subtitle}</p>
    <slot name="actions" />
  </div>
</section>
